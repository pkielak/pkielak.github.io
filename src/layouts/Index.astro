---
import Main from "./Main.astro";
import { SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";
import ContactForm from "../components/ContactForm.astro";
import GraphWrapper from "src/components/GraphWrapper.astro";
import ConsoleLoading from "../components/ConsoleLoading.astro";
import OrbitSystem from "../components/OrbitSystem.astro";
import { Image } from "astro:assets";
import { type IndexLocale } from "../content.config";

import avatar from "../../public/avatar.png";

interface Props {
  locale: IndexLocale;
}

const { locale } = Astro.props;

const posts = (await getCollection("notes"))
  .sort((a, b) => {
    const aDate = a.data.updatedAt || a.data.pubDate;
    const bDate = b.data.updatedAt || b.data.pubDate;
    return bDate.valueOf() - aDate.valueOf();
  })
  .slice(0, 3);
---

<Main title={SITE_TITLE} description={locale.description}>
  <!-- Console-like Initialization Screen -->
  <ConsoleLoading />

  <main class="canvas-container">
    <canvas id="space-canvas"></canvas>
    <div class="ui-overlay">
      <section class="content-section">
        <div class="container">
          <h1>{locale.heading}</h1>
          <h3 class="opacity-70">
            {locale.subheading}<span class="cursor" style="--cursor-opacity: 1;"
              >_</span
            >
          </h3>
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container">
          <div class="avatar-section">
            <Image src={avatar} alt="Avatar" class="avatar" />
          </div>
          <div>
            <h3>{locale.greeting}</h3>
            <p>
              {locale.introText1}
            </p>
          </div>
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container">
          <h2>{locale.motivationTitle}</h2>
          <p>
            {locale.motivationText}
          </p>
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container skills">
          <OrbitSystem title={locale.skills} />
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container projects">
          <h3>{locale.projectTitle}</h3>
          <div>
            <div>
              <h4>
                <a href="https://pkielak.me/kopista/" target="_blank">Kopista</a
                >
              </h4>
              <p>
                {locale.kopistaDescription}
              </p>
              <a href="https://github.com/pkielak/kopista" target="_blank"
                >GitHub</a
              >
            </div>
          </div>
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container">
          <h3>{locale.postsTitle}</h3>
          {
            posts.map((post) => (
              <div>
                <a href={`/notes/${post.id}/`} class="post">
                  <p>
                    {post.data.title} |{" "}
                    <FormattedDate
                      date={post.data.updatedAt || post.data.pubDate}
                    />
                  </p>
                </a>
                <p>{post.data.description}</p>
              </div>
            ))
          }
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section class="content-section">
        <div class="container">
          <h3>{locale.contactTitle}</h3>
          <ContactForm locale={locale} />
        </div>
      </section>
      <div class="scroll-anchor"></div>

      <section id="universe" class="content-section">
        <div class="overlay">
          <h3>
            {locale.universeHeading}
          </h3>
          <p>
            {locale.universeSubheading}
          </p>
        </div>
        <GraphWrapper />
      </section>
      <div class="scroll-anchor"></div>
    </div>
  </main>
</Main>
<style>
  h3 {
    margin-top: 0;
  }

  .avatar-section {
    position: relative;
    background-color: var(--nord14-aurora);
    opacity: 0.6;
    aspect-ratio: 1;
    max-width: 256px;
    margin: 0 auto;
    margin-bottom: 1rem;

    &::after {
      content: "";
      position: absolute;
      inset: 0;
      background: repeating-linear-gradient(
        to bottom,
        rgba(0, 0, 0, 0.08) 0,
        rgba(0, 0, 0, 0.08) 1px,
        transparent 1px,
        transparent 4px
      );
      pointer-events: none;
      aspect-ratio: 1;
    }
  }

  .avatar {
    height: auto;
    margin: 0 auto;
    max-width: 256px;
    object-fit: cover;
    filter: grayscale(100%) contrast(3) brightness(0.75) saturate(50%);
    mix-blend-mode: overlay;
  }

  h1 span {
    color: var(--nord14-aurora);
  }

  .cursor {
    display: inline-block;
    animation: blink 1s step-end infinite;
    color: var(--nord14-aurora);
    opacity: var(--cursor-opacity, 1);
  }

  @keyframes blink {
    0%,
    100% {
      opacity: var(--cursor-opacity, 1);
    }
    50% {
      opacity: 0;
    }
  }

  .canvas-container {
    position: relative;
    top: 0;
    left: 0;
    width: 100vw;
  }

  #space-canvas {
    top: 0;
    left: 0;
    position: fixed;
    display: block;
    width: 100%;
    height: 100%;
  }

  .ui-overlay {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    font-family: "IBM Plex Mono", monospace;
  }

  .content-section {
    width: 100%;
    height: 100svh;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0;
    left: 0;
    z-index: 10;
    opacity: 0;
    align-items: center;
    justify-content: center;
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform: translateZ(0);
  }

  .container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: start;
    position: absolute;
    left: 50%;
    padding: 1rem;
    width: calc(100% - 2rem);
  }

  .container p:last-of-type {
    margin-bottom: 0;
  }

  .content-section:first-of-type .container,
  .content-section:last-of-type .container {
    aspect-ratio: unset;
  }

  .content-section:nth-of-type(1) .container,
  .container.skills {
    padding: 0;
  }

  .content-section:nth-of-type(2) .container .polygon-border {
    scale: 3;
  }

  .content-section:nth-of-type(4n + 1) .container,
  .content-section:nth-of-type(4n + 3) .container {
    top: 25svh;
    transform: translate(-50%, -50%);
  }

  .content-section:nth-of-type(4n + 2) .container,
  .content-section:nth-of-type(4n) .container {
    bottom: 25svh;
    transform: translate(-50%, 50%);
  }

  .scroll-anchor {
    width: 1px;
    height: 100svh;
    pointer-events: none;
  }

  .overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 9;
  }

  @media (min-width: 1024px) {
    .container {
      width: auto;
      max-width: 90%;

      & .polygon-border {
        scale: 1.33;
      }
    }

    .content-section:nth-of-type(2) .container .polygon-border {
      scale: 1.5;
    }
  }

  @media (min-width: 1280px) {
    .content-section:nth-of-type(4n + 1) .container,
    .content-section:nth-of-type(4n + 2) .container {
      top: 25svh;
      bottom: unset;
      transform: translate(0, -50%);
    }

    .content-section:nth-of-type(4n + 3) .container,
    .content-section:nth-of-type(4n) .container {
      top: unset;
      bottom: 25svh;
      transform: translate(0, 50%);
    }

    .content-section:nth-of-type(4n + 1) .container,
    .content-section:nth-of-type(4n) .container {
      left: 8rem;
    }

    .content-section:nth-of-type(4n + 2) .container,
    .content-section:nth-of-type(4n + 3) .container {
      left: unset;
      right: 8rem;
    }

    .content-section:last-of-type .container {
      left: 0;
      right: unset;
    }

    .container {
      max-width: 800px;
    }
  }

  /* Mobile performance optimizations */
  @media (max-width: 768px) {
    #space-canvas {
      /* Reduce canvas quality on mobile */
      image-rendering: pixelated;
    }

    /* Reduce animation complexity */
    .cursor {
      animation: none;
      opacity: 1 !important;
    }
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
      opacity: 1 !important;
    }

    #space-canvas {
      display: none;
    }

    .canvas-container {
      background: linear-gradient(
        180deg,
        #2e3440 0%,
        #3b4252 50%,
        #2e3440 100%
      );
      height: 100vh;
    }

    body.is-mobile #space-canvas {
      image-rendering: pixelated;
      transform: translateZ(0);
    }
  }
</style>

<script>
  import { init } from "../lib/init.js";
  import { detectPerformanceCapabilities } from "../lib/performance.js";

  (function () {
    const supportedLocales = ["en", "pl"];
    const defaultLocale = "en";

    const browserLang = navigator.language || defaultLocale;
    const userLang = browserLang.split("-")[0].toLowerCase();
    const targetLocale = supportedLocales.includes(userLang)
      ? userLang
      : defaultLocale;

    console.log("Browser language:", browserLang);
    console.log("Target locale:", targetLocale);

    // Only skip redirect if already on the correct locale path
    const currentPath = window.location.pathname;
    if (currentPath === `/${targetLocale}/`) {
      return;
    }

    window.location.replace(`/${targetLocale}/`);
  })();
  // Early performance detection to set body classes
  if (typeof window !== "undefined") {
    const { isMobile } = detectPerformanceCapabilities();
    if (isMobile) {
      document.body.classList.add("is-mobile");
    }
  }

  init();
</script>
