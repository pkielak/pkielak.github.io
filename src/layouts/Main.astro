---
import BaseHead from "../components/BaseHead.astro";

interface Props {
  title: string;
  description: string;
  isGraphSmall?: boolean;
}

const { title, description } = Astro.props;
const today = new Date();
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <slot />
  </body>
</html>

