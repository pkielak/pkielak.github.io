---
import en from '@/i18n/en.json';
import pl from '@/i18n/pl.json';

const translations = { en, pl } as const;
const locale = Astro.currentLocale ?? 'en';
const t = Object.hasOwn(translations, locale) ? translations[locale as keyof typeof translations] : en;
---
<section id="skills" class="section" aria-labelledby="skills-title">
    <h2 id="skills-title" class="section__title">{t.skills.title}</h2>
    <div class="grid">
        {
            Object.entries(t.skills.categories).map(([key, category]) => (
                <article class="skill-card card">
                    <h3 class="skill-card__title">{category.title}</h3>
                    <p class="skill-card__description">{category.description}</p>
                    <ul class="skill-card__items">
                        {
                            category.items.map((item) => (
                                <li class="skill">
                                    <span class="skill__name">{item.name}</span>
                                    <span class="skill__level" title={t.skills.aiAssisted}>
                                        {
                                            t.skills.levels[
                                                item.level as keyof typeof t.skills.levels
                                            ]
                                        }
                                    </span>
                                </li>
                            ))
                        }
                    </ul>
                </article>
            ))
        }
    </div>
</section>

<style>
    .skill-card__title {
        margin: 0 0 0.5rem;
    }

    .skill-card__description {
        color: var(--color-muted);
        font-size: 0.9rem;
        margin: 0 0 1rem;
    }

    .skill-card__items {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
    }

    .skill {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.95rem;
    }

    .skill__level {
        color: var(--color-accent);
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
</style>
