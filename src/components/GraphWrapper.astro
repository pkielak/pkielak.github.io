---
import { getGraph } from "@/lib/graph";

interface Props {
  /** Render as a bordered inline block (e.g. on the home page) instead of
   *  the full-viewport page view. */
  embedded?: boolean;
}

const { embedded = false } = Astro.props;
const graphData = await getGraph();

// Escape `<` so labels containing e.g. `</script>` can't break out of the tag.
const graphDataJson = JSON.stringify(graphData).replace(/</g, "\\u003c");
---

<div class={embedded ? "controls-wrapper controls-wrapper--embedded" : "controls-wrapper"}>
  {embedded ? null : (
    <>
      <div id="tap-to-unlock" class="tap-to-unlock visible">
        Tap to unlock the graph
      </div>
      <button id="lock-graph" class="lock-graph"> Lock graph </button>
    </>
  )}
  <div id="graph-wrapper" class={embedded ? "graph-wrapper graph-wrapper--embedded" : "graph-wrapper"}>
    {embedded ? null : (
      <span class="zoom-control-text">Hold Ctrl + Scroll to Zoom</span>
    )}

    <div id="network-container" class="network-container">
    </div>
    <script type="application/json" id="graph-data" set:html={graphDataJson} />
  </div>
</div>

<style>
  main {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .graph-wrapper {
    width: 100%;
    height: 100svh;
    padding-top: var(--header-height);
    position: relative;
  }

  /* Inline variant: a bordered, fixed-height block for embedding in a section */
  .graph-wrapper--embedded {
    height: min(60svh, 480px);
    padding-top: 0;
    border: 1px solid var(--color-border);
    background: var(--nord0-polar-night);
  }

  .network-container {
    height: 100%;
    width: 100%;
  }

  .lock-graph {
    position: absolute;
    left: 1rem;
    bottom: 2rem;
    z-index: 2;
    display: none;
    font-family: var(--font-mono);
    border: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    background: none;
    color: var(--nord4-snow-storm);
  }

  .zoom-control-text {
    font-family: var(--font-mono);
    position: absolute;
    bottom: 0;
    left: 1rem;
    pointer-events: none;
    display: none;
  }

  .tap-to-unlock {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: calc(100svh - var(--header-height));
    background: #2e344090;
    font-family: var(--font-mono);
    position: absolute;
    top: var(--header-height);
    left: 0;
    z-index: 1;
  }

  .visible {
    display: flex;
  }

  .controls-wrapper {
    position: relative;
    z-index: 1;
  }

  @media (hover: hover) and (pointer: fine) {
    .zoom-control-text {
      display: block;
    }

    .tap-to-unlock {
      display: none;
    }

    .lock-graph {
      display: none;
    }
  }
</style>

<script type="module" is:inline data-astro-rerun>
  (() => {
    function onUnlock(overlay, button) {
      overlay?.classList.toggle("visible");
      button?.classList.toggle("visible");
    }

    function init() {
      const tapToUnlock = document.getElementById("tap-to-unlock");
      const lockGraph = document.getElementById("lock-graph");

      // Embedded variant has no unlock overlay / lock button.
      if (!tapToUnlock && !lockGraph) return;

      [tapToUnlock, lockGraph].forEach((element) =>
        element?.addEventListener("click", () =>
          onUnlock(tapToUnlock, lockGraph),
        ),
      );
    }
    init();
  })();
</script>

<script>
  import { Network, type Data, type Options } from "vis-network";

  const container = document.getElementById("network-container");
  const data = document.getElementById("graph-data")?.textContent;

  // Note: can't use define:vars here — Astro emits define:vars scripts as
  // classic (non-module) inline scripts, which breaks the import below.
  // The embedded variant is detected via the wrapper class instead.
  const embedded = container?.closest(".graph-wrapper--embedded") !== null;

  if (container && data) {
    // vis-network draws labels onto a canvas at init, so make sure the
    // label font is actually loaded first or it falls back to a default.
    if ("fonts" in document) {
      await document.fonts
        .load('16px "JetBrains Mono"')
        .catch(() => {});
    }

    const graphData = JSON.parse(data) as Data;

    const options: Options = {
      nodes: {
        fixed: true,
        font: {
          color: "#eceff4",
          size: 16,
          strokeColor: "#2e3440",
          face: "JetBrains Mono",
        },
        color: {
          border: "#2e3440",
          background: "#a3be8c",
          hover: { background: "#5e81ac", border: "#2e3440" },
          highlight: { background: "#bf616a", border: "#2e3440" },
        },
        shape: "square",
        size: 12,
      },
      edges: {
        color: "#4c566a",
        width: 2,
      },
      // Embedded in a scrolling page: no pan/zoom so touch gestures and
      // the wheel keep scrolling the page instead of moving the graph.
      interaction: embedded
        ? { hover: true }
        : {
            hover: true,
            zoomView: window.matchMedia("(pointer: coarse)").matches,
          },
    };

    const network = new Network(container, graphData, options);

    network.on("click", (params) => {
      if (params.nodes.length > 0) {
        window.location.href = `/notes/${params.nodes[0]}/`;
      }
    });

    window.addEventListener("resize", () => {
      network.fit();
    });

    if (!embedded) {
      container.addEventListener(
        "wheel",
        (e: WheelEvent) => {
          if (!e.ctrlKey) return;
          e.preventDefault();
          const scale = network.getScale();
          network.moveTo({ scale: scale * (e.deltaY > 0 ? 0.9 : 1.1) });
        },
        { passive: false },
      );
    }

  }
</script>
