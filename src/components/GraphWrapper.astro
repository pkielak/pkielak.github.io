---
import { getGraph } from "../lib/graph";

const graphData = await getGraph();

// Escape `<` so labels containing e.g. `</script>` can't break out of the tag.
const graphDataJson = JSON.stringify(graphData).replace(/</g, "\\u003c");
---

<div class="controls-wrapper">
  <div id="tap-to-unlock" class="tap-to-unlock visible">
    Tap to unlock the graph
  </div>
  <button id="lock-graph" class="lock-graph"> Lock graph </button>
  <div id="graph-wrapper" class="graph-wrapper">
    <span class="zoom-control-text">Hold Ctrl + Scroll to Zoom</span>

    <div id="network-container" class="network-container" transition:persist>
    </div>
    <script type="application/json" id="graph-data" set:html={graphDataJson} />
  </div>
</div>

<style>
  main {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .graph-wrapper {
    width: 100%;
    height: 100svh;
    position: relative;
  }

  .network-container {
    height: 100%;
    width: 100%;
  }

  .lock-graph {
    position: absolute;
    left: 1rem;
    bottom: 2rem;
    z-index: 2;
    display: none;
    font-family: "IBM Plex Mono", monospace;
    border: 0;
    padding: 0;
    justify-content: center;
    align-items: center;
    background: none;
    color: var(--nord4-snow-storm);
  }

  .zoom-control-text {
    font-family: "IBM Plex Mono", monospace;
    position: absolute;
    bottom: 0;
    left: 1rem;
    pointer-events: none;
    display: none;
  }

  .tap-to-unlock {
    display: none;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100svh;
    background: #2e344090;
    font-family: "IBM Plex Mono", monospace;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
  }

  .visible {
    display: flex;
  }

  .controls-wrapper {
    position: relative;
    z-index: 1;
  }

  @media (min-width: 768px) {
    .tap-to-unlock {
      height: 100vh;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .zoom-control-text {
      display: block;
    }

    .tap-to-unlock {
      display: none;
    }

    .lock-graph {
      display: none;
    }
  }
</style>

<script type="module" is:inline data-astro-rerun>
  (() => {
    function onUnlock(overlay, button) {
      overlay?.classList.toggle("visible");
      button?.classList.toggle("visible");
    }

    function init() {
      const tapToUnlock = document.getElementById("tap-to-unlock");
      const lockGraph = document.getElementById("lock-graph");

      [tapToUnlock, lockGraph].forEach((element) =>
        element.addEventListener("click", () =>
          onUnlock(tapToUnlock, lockGraph),
        ),
      );
    }
    init();
  })();
</script>

<script>
  import { navigate } from "astro:transitions/client";
  import { Network, type Data, type Options } from "vis-network";

  const container = document.getElementById("network-container");
  const data = document.getElementById("graph-data")?.textContent;

  if (container && data) {
    const graphData = JSON.parse(data) as Data;

    const options: Options = {
      nodes: {
        fixed: true,
        font: {
          color: "#eceff4",
          size: 16,
          strokeColor: "#2e3440",
          face: "IBM Plex Mono",
        },
        color: {
          border: "#2e3440",
          background: "#a3be8c",
          hover: { background: "#5e81ac", border: "#2e3440" },
          highlight: { background: "#bf616a", border: "#2e3440" },
        },
        shape: "square",
        size: 12,
      },
      edges: {
        color: "#4c566a",
        width: 2,
      },
      interaction: {
        hover: true,
        zoomView: window.matchMedia("(pointer: coarse)").matches,
      },
    };

    const network = new Network(container, graphData, options);

    network.on("click", (params) => {
      if (params.nodes.length > 0) {
        navigate(`/notes/${params.nodes[0]}/`);
      }
    });

    window.addEventListener("resize", () => {
      network.fit();
    });

    container.addEventListener(
      "wheel",
      (e: WheelEvent) => {
        if (!e.ctrlKey) return;
        e.preventDefault();
        const scale = network.getScale();
        network.moveTo({ scale: scale * (e.deltaY > 0 ? 0.9 : 1.1) });
      },
      { passive: false },
    );

    document.addEventListener("astro:page-load", () => {
      const pathParts = window.location.pathname.split("/").filter(Boolean);
      const locationKey =
        pathParts[pathParts.length - 1] ||
        pathParts[pathParts.length - 2] ||
        "";

      if (locationKey && network.findNode(locationKey)) {
        network.selectNodes([locationKey]);
      }

      window.scrollTo(0, 0);
    });
  }
</script>
