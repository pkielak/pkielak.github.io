---
import { getGraph } from "../lib/graph";

interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;

const { nodes, edges } = await getGraph();

const backlinks = edges.filter((edge) => edge.to === postSlug);
---

{
  backlinks.length > 0 && (
    <>
      <h5 class="backlinks-title">Backlinks</h5>
      <ol class="backlinks">
        {backlinks.map((backlink) => {
          const referenceNode = nodes.find(
            (node) => backlink.from === node?.id,
          );
          return (
            <li class="backlink">
              <div>
                <a href={`/notes/${referenceNode?.id}`}>
                  <h6>{referenceNode?.label || backlink.from}</h6>
                  {referenceNode?.title && <p>{referenceNode.title}</p>}
                </a>
              </div>
            </li>
          );
        })}
      </ol>
    </>
  )
}

<style>
  .backlink a {
    text-decoration: none;
    color: var(--nord0);
  }

  .backlink a p {
    margin-top: 0;
  }

  .backlinks-title {
    margin: 1.5em 0 1em;
  }
</style>
