---
import { getGraph } from '@/lib/graph';

interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;

const { nodes, edges } = await getGraph();

const backlinks = edges.filter((edge) => edge.to === postSlug);
---

{
	backlinks.length > 0 && (
		<>
			<h5 class="backlinks-title">backlinks</h5>
			<ol class="backlinks">
				{backlinks.map((backlink) => {
					const referenceNode = nodes.find(
						(node) => backlink.from === node?.id,
					);
					return (
						<li class="backlink">
							<div>
								<a href={`/notes/${referenceNode?.id}`}>
									<h6>{referenceNode?.label || backlink.from}</h6>
									{referenceNode?.title && (
										<p>{referenceNode.title}</p>
									)}
								</a>
							</div>
						</li>
					);
				})}
			</ol>
		</>
	)
}

<style>
	.backlinks-title {
		margin: 2em 0 1em;
		font-size: 1.05rem;
		font-weight: 600;
	}

	.backlinks-title::before {
		content: '# ';
		color: var(--color-accent);
	}

	.backlinks {
		padding-left: 1.4rem;
	}

	.backlink a {
		text-decoration: none;
		color: var(--color-accent);
	}

	.backlink a:hover {
		text-decoration: underline;
	}

	.backlink h6 {
		margin: 0;
		font-size: 0.95rem;
	}

	.backlink p {
		margin: 0.25em 0 0;
		color: var(--color-muted);
		font-size: 0.85rem;
	}
</style>
